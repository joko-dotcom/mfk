  "description": "WhatsApp bot (Baileys) for Mafia Koi Marketplace — bid via WA, group broadcasts, bid-and-run alerts.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
