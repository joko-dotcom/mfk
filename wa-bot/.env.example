# Mafia Koi WhatsApp bot
# Bot calls back to the Next.js app (MAIN_APP_URL) and also accepts webhook
# requests from the Next.js app (authenticated with WA_BOT_SECRET).

# Shared secret (must match Next.js WA_BOT_SECRET)
WA_BOT_SECRET="change-me-long-random-string"

# Where the Next.js app lives (for command callbacks)
MAIN_APP_URL="https://mafiakoi.vercel.app"

# Port the bot listens on for /send/* webhook calls from Next.js
WA_BOT_PORT="4000"

# Folder where Baileys stores session creds (mount a volume in prod!)
WA_AUTH_DIR="./auth_info"
