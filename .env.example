# PostgreSQL (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Cron endpoints (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET="replace-with-long-random-string"

# Payment / bid-and-run window (hours)
PAYMENT_WINDOW_HOURS="24"

# WhatsApp bot integration. The wa-bot is deployed separately (Railway/Fly/VPS)
# because Baileys needs a long-running process. When these are unset, the main
# app still works but WhatsApp broadcasts are silently skipped.
WA_BOT_URL="https://wa-bot.example.com"
WA_BOT_SECRET="shared-secret-matching-wa-bot-env"
