// Mafia Koi Marketplace — Prisma Schema (a.k.a. KXA: Koi X Auction)
// Multi-vendor koi marketplace with auctions (OB/KB/BIN), wallet + deposit
// (mock), escrow, BNR anti-fraud, consignment (KC), Azukari boarding,
// leaderboard, live auction streaming & WhatsApp bot integration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum MembershipTier {
  NONE
  SILVER
  GOLD
  PLATINUM
}

enum SellerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SOLD
  CANCELLED
}

enum ListingMode {
  FIXED
  AUCTION
}

enum AuctionKind {
  OB
  KB
  BIN
}

enum WalletTxType {
  DEPOSIT
  WITHDRAW
  BID_HOLD
  BID_RELEASE
  WIN_DEBIT
  ESCROW_HOLD
  ESCROW_RELEASE
  FEE
  PENALTY
  SELLER_DEPOSIT
  SELLER_PAYOUT
  REFUND
  ADJUSTMENT
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  MOCK
  MIDTRANS
  XENDIT
  MANUAL_BANK_TRANSFER
}

enum ConsignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AzukariStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum KoiCategory {
  GOSANKE_KOHAKU
  GOSANKE_SANKE
  GOSANKE_SHOWA
  NON_GOSANKE
  BABY_KOI
  JUMBO_KOI
  RARE_COLLECTION
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_ESCROW
  SHIPPED
  DELIVERED
  RELEASED
  REFUNDED
  CANCELLED
  DEFAULTED
}

enum BlacklistReason {
  BID_AND_RUN
  FRAUD
  ABUSE
  MANUAL
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  username         String?          @unique
  phone            String?
  phoneVerified    Boolean          @default(false)
  otpCode          String?
  otpExpires       DateTime?
  name             String
  passwordHash     String
  role             UserRole         @default(BUYER)
  membershipTier   MembershipTier   @default(NONE)
  membershipUntil  DateTime?
  avatarUrl        String?
  bio              String?
  whatsappNumber   String?          @unique
  whatsappVerified Boolean          @default(false)
  waLinkCode       String?
  waLinkExpires    DateTime?
  isBlacklisted    Boolean          @default(false)
  blacklistReason  BlacklistReason?
  blacklistNote    String?
  bidAndRunCount   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  seller            Seller?
  bids              Bid[]
  orders            Order[]              @relation("BuyerOrders")
  reviews           Review[]             @relation("AuthorReviews")
  receivedReviews   Review[]             @relation("SubjectReviews")
  follows           Follow[]             @relation("Follower")
  followers         Follow[]             @relation("Following")
  posts             CommunityPost[]
  comments          CommunityComment[]
  likes             PostLike[]
  chats             LiveChat[]
  watchlist         Watchlist[]
  strikes           BlacklistStrike[]
  wallet            Wallet?
  walletTxs         WalletTx[]
  deposits          DepositRequest[]
  withdrawals       WithdrawalRequest[]
  consignmentsOwned ConsignmentListing[] @relation("ConsignmentOwner")
  azukariContracts  AzukariContract[]    @relation("AzukariOwner")
  notifications     Notification[]
  activityLogs      ActivityLog[]
}

model Seller {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName          String
  slug              String       @unique
  description       String?
  addressDetail     String?
  location          String
  city              String?
  province          String
  ktpNumber         String?
  ktpUrl            String?
  selfieWithKtpUrl  String?
  faceUrl           String?
  farmPhotoUrl      String?
  socialInstagram   String?
  socialTiktok      String?
  socialYoutube     String?
  socialFacebook    String?
  socialWebsite     String?
  status            SellerStatus @default(PENDING)
  verified          Boolean      @default(false)
  topSeller         Boolean      @default(false)
  championBreeder   Boolean      @default(false)
  rating            Float        @default(0)
  totalSales        Int          @default(0)
  whatsappGroupId   String?
  whatsappGroupName String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  listings           Koi[]
  consignmentsHosted ConsignmentListing[] @relation("ConsignmentHost")
  azukariHosted      AzukariContract[]    @relation("AzukariHost")
}

model Koi {
  id             String        @id @default(cuid())
  sellerId       String
  seller         Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name           String
  slug           String        @unique
  category       KoiCategory
  bloodline      String?
  breederName    String?
  sizeCm         Int
  ageMonths      Int?
  sex            String?
  description    String
  coverImage     String
  media          KoiMedia[]
  price          Int
  mode           ListingMode   @default(FIXED)
  status         ListingStatus @default(PENDING_APPROVAL)
  featured       Boolean       @default(false)
  viewCount      Int           @default(0)
  likeCount      Int           @default(0)
  certificateUrl String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  auction    Auction?
  orders     Order[]
  watchlists Watchlist[]
  posts      CommunityPost[]

  @@index([category, status])
  @@index([sellerId])
}

model KoiMedia {
  id    String @id @default(cuid())
  koiId String
  koi   Koi    @relation(fields: [koiId], references: [id], onDelete: Cascade)
  url   String
  type  String
  order Int    @default(0)
}

model Auction {
  id                  String         @id @default(cuid())
  koiId               String         @unique
  koi                 Koi            @relation(fields: [koiId], references: [id], onDelete: Cascade)
  kind                AuctionKind    @default(OB)
  startingBid         Int
  currentBid          Int
  minIncrement        Int            @default(100000)
  bidStep             Int?
  reservePrice        Int?
  buyItNowPrice       Int?
  startTime           DateTime
  endTime             DateTime
  status              AuctionStatus  @default(SCHEDULED)
  antiSniperMinutes   Int            @default(3)
  antiSniperExtendSec Int            @default(600)
  memberOnly          Boolean        @default(false)
  minTier             MembershipTier @default(NONE)
  requiredDeposit     Int            @default(0)
  winnerId            String?
  winningBid          Int?
  boughtViaBin        Boolean        @default(false)
  liveStreamUrl       String?
  liveActive          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bids  Bid[]
  chats LiveChat[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

model LiveChat {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  kind      String   @default("chat")
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

model Order {
  id                String      @id @default(cuid())
  koiId             String
  koi               Koi         @relation(fields: [koiId], references: [id])
  buyerId           String
  buyer             User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  amount            Int
  feeAmount         Int         @default(0)
  status            OrderStatus @default(PENDING_PAYMENT)
  paymentRef        String?
  shippingAddress   String?
  courier           String?
  trackingNo        String?
  oxygenHours       Int?
  packingNote       String?
  paymentDueAt      DateTime?
  flaggedBidAndRun  Boolean     @default(false)
  sourceAuctionId   String?
  notifiedDefaultAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, paymentDueAt])
}

model BlacklistStrike {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    BlacklistReason
  orderId   String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([userId])
}

model WaBotSession {
  id          String    @id @default(cuid())
  label       String    @unique
  status      String    @default("disconnected")
  phoneNumber String?
  lastSeenAt  DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
}

model WaInboundLog {
  id        String   @id @default(cuid())
  jid       String
  userId    String?
  command   String
  payload   String?
  result    String?
  createdAt DateTime @default(now())

  @@index([jid, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("AuthorReviews", fields: [authorId], references: [id])
  subjectId String
  subject   User     @relation("SubjectReviews", fields: [subjectId], references: [id])
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@index([subjectId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  koiId     String?
  koi       Koi?     @relation(fields: [koiId], references: [id])
  title     String
  body      String
  imageUrl  String?
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CommunityComment[]
  likes    PostLike[]
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
}

model PostLike {
  id     String        @id @default(cuid())
  postId String
  userId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  koiId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  koi       Koi      @relation(fields: [koiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, koiId])
}

model PlatformSetting {
  id                   String        @id @default(cuid())
  auctionFeeBps        Int           @default(700)
  listingFeeIDR        Int           @default(0)
  silverPriceIDR       Int           @default(99000)
  goldPriceIDR         Int           @default(299000)
  platinumPriceIDR     Int           @default(999000)
  minBuyerDepositIDR   Int           @default(500000)
  minSellerDepositIDR  Int           @default(1000000)
  bnrPenaltyBps        Int           @default(5000) // 50%
  bnrStrikesForBan     Int           @default(2)
  withdrawalFeeIDR     Int           @default(5000)
  withdrawalMinIDR     Int           @default(50000)
  azukariMonthlyFeeIDR Int           @default(250000)
  kcFeeBps             Int           @default(1500) // 15% for consignment
  paymentMethodDefault PaymentMethod @default(MOCK)
  waBotNumber          String?
  waAutoReply          String?
  updatedAt            DateTime      @default(now()) @updatedAt
}

model Wallet {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance     Int      @default(0)
  escrowBalance        Int      @default(0)
  sellerDepositBalance Int      @default(0)
  totalSpent           Int      @default(0)
  totalEarned          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model WalletTx {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         WalletTxType
  amount       Int
  balanceAfter Int          @default(0)
  escrowAfter  Int          @default(0)
  reference    String?
  note         String?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model DepositRequest {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  method     PaymentMethod @default(MOCK)
  status     DepositStatus @default(PENDING)
  paymentRef String?
  purpose    String        @default("BUYER") // BUYER | SELLER
  proofUrl   String?
  note       String?
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model WithdrawalRequest {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  feeAmount   Int              @default(0)
  netAmount   Int              @default(0)
  bankName    String
  bankAccount String
  accountName String
  status      WithdrawalStatus @default(PENDING)
  note        String?
  processedAt DateTime?
  processedBy String?
  paymentRef  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model ConsignmentListing {
  id           String            @id @default(cuid())
  ownerUserId  String
  owner        User              @relation("ConsignmentOwner", fields: [ownerUserId], references: [id])
  hostSellerId String
  hostSeller   Seller            @relation("ConsignmentHost", fields: [hostSellerId], references: [id])
  koiName      String
  sizeCm       Int
  bloodline    String?
  description  String?
  askingPrice  Int
  feeBps       Int               @default(1500)
  photoUrl     String?
  status       ConsignmentStatus @default(PENDING)
  soldPrice    Int?
  soldAt       DateTime?
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([hostSellerId, status])
  @@index([ownerUserId])
}

model AzukariContract {
  id            String        @id @default(cuid())
  ownerUserId   String
  owner         User          @relation("AzukariOwner", fields: [ownerUserId], references: [id])
  hostSellerId  String
  hostSeller    Seller        @relation("AzukariHost", fields: [hostSellerId], references: [id])
  koiName       String
  sizeCm        Int
  bloodline     String?
  photoUrl      String?
  monthlyFeeIDR Int           @default(250000)
  startDate     DateTime      @default(now())
  endDate       DateTime?
  status        AzukariStatus @default(ACTIVE)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([hostSellerId, status])
  @@index([ownerUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  ip        String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
