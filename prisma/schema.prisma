// Mafia Koi Marketplace - Prisma Schema
// Multi-vendor koi marketplace with auctions, live streaming, membership tiers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum MembershipTier {
  NONE
  SILVER
  GOLD
  PLATINUM
}

enum SellerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SOLD
  CANCELLED
}

enum ListingMode {
  FIXED
  AUCTION
}

enum KoiCategory {
  GOSANKE_KOHAKU
  GOSANKE_SANKE
  GOSANKE_SHOWA
  NON_GOSANKE
  BABY_KOI
  JUMBO_KOI
  RARE_COLLECTION
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_ESCROW
  SHIPPED
  DELIVERED
  RELEASED
  REFUNDED
  CANCELLED
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  phone           String?
  name            String
  passwordHash    String
  role            UserRole       @default(BUYER)
  membershipTier  MembershipTier @default(NONE)
  membershipUntil DateTime?
  avatarUrl       String?
  bio             String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  seller          Seller?
  bids            Bid[]
  orders          Order[]            @relation("BuyerOrders")
  reviews         Review[]           @relation("AuthorReviews")
  receivedReviews Review[]           @relation("SubjectReviews")
  follows         Follow[]           @relation("Follower")
  followers       Follow[]           @relation("Following")
  posts           CommunityPost[]
  comments        CommunityComment[]
  likes           PostLike[]
  chats           LiveChat[]
  watchlist       Watchlist[]
}

model Seller {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName        String
  slug            String       @unique
  description     String?
  location        String
  province        String
  ktpNumber       String?
  ktpUrl          String?
  farmPhotoUrl    String?
  status          SellerStatus @default(PENDING)
  verified        Boolean      @default(false)
  topSeller       Boolean      @default(false)
  championBreeder Boolean      @default(false)
  rating          Float        @default(0)
  totalSales      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  listings Koi[]
}

model Koi {
  id             String        @id @default(cuid())
  sellerId       String
  seller         Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name           String
  slug           String        @unique
  category       KoiCategory
  bloodline      String?
  breederName    String?
  sizeCm         Int
  ageMonths      Int?
  sex            String?
  description    String
  coverImage     String
  media          KoiMedia[]
  price          Int
  mode           ListingMode   @default(FIXED)
  status         ListingStatus @default(PENDING_APPROVAL)
  featured       Boolean       @default(false)
  viewCount      Int           @default(0)
  likeCount      Int           @default(0)
  certificateUrl String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  auction    Auction?
  orders     Order[]
  watchlists Watchlist[]
  posts      CommunityPost[]

  @@index([category, status])
  @@index([sellerId])
}

model KoiMedia {
  id    String @id @default(cuid())
  koiId String
  koi   Koi    @relation(fields: [koiId], references: [id], onDelete: Cascade)
  url   String
  type  String
  order Int    @default(0)
}

model Auction {
  id                String         @id @default(cuid())
  koiId             String         @unique
  koi               Koi            @relation(fields: [koiId], references: [id], onDelete: Cascade)
  startingBid       Int
  currentBid        Int
  minIncrement      Int            @default(100000)
  reservePrice      Int?
  startTime         DateTime
  endTime           DateTime
  status            AuctionStatus  @default(SCHEDULED)
  antiSniperMinutes Int            @default(3)
  memberOnly        Boolean        @default(false)
  minTier           MembershipTier @default(NONE)
  winnerId          String?
  liveStreamUrl     String?
  liveActive        Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  bids  Bid[]
  chats LiveChat[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

model LiveChat {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  kind      String   @default("chat")
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

model Order {
  id              String      @id @default(cuid())
  koiId           String
  koi             Koi         @relation(fields: [koiId], references: [id])
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  amount          Int
  feeAmount       Int         @default(0)
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentRef      String?
  shippingAddress String?
  courier         String?
  trackingNo      String?
  oxygenHours     Int?
  packingNote     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("AuthorReviews", fields: [authorId], references: [id])
  subjectId String
  subject   User     @relation("SubjectReviews", fields: [subjectId], references: [id])
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@index([subjectId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  koiId     String?
  koi       Koi?     @relation(fields: [koiId], references: [id])
  title     String
  body      String
  imageUrl  String?
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CommunityComment[]
  likes    PostLike[]
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
}

model PostLike {
  id     String        @id @default(cuid())
  postId String
  userId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  koiId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  koi       Koi      @relation(fields: [koiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, koiId])
}

model PlatformSetting {
  id               String   @id @default(cuid())
  auctionFeeBps    Int      @default(700)
  listingFeeIDR    Int      @default(0)
  silverPriceIDR   Int      @default(99000)
  goldPriceIDR     Int      @default(299000)
  platinumPriceIDR Int      @default(999000)
  updatedAt        DateTime @updatedAt @default(now())
}
